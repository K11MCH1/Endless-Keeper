// EndlessKeeper.exe: the launcher's icon, its header picture and version
#include <winver.h>
1 ICON "endless-keeper.ico"
100 RCDATA "header.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Endless Keeper"
      VALUE "ProductName", "Endless Keeper"
      VALUE "FileVersion", "1.0"
      VALUE "OriginalFilename", "EndlessKeeper.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
